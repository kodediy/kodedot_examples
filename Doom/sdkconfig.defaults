# app_doom — Kode Dot v2 (ESP32-P4).
# OJO: este fichero solo siembra el sdkconfig la PRIMERA vez. Verificar flags en
# build/config/sdkconfig.h, nunca aqui.
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Tabla para flasheo standalone (espeja el tamano de ota_0 para que el size-check
# valga). Si la app se arranca desde otro sitio, manda la tabla ya flasheada.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_dev.csv"
# --- PSRAM: el bloque COMPLETO; con menos de esto el WAD no cabe ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_BOOT_HW_INIT=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
# --- cache/MMU: 512K de L2 mata el arranque (0x101). NO subir de 128K. ---
CONFIG_CACHE_L2_CACHE_128KB=y
CONFIG_MMU_PAGE_SIZE_64KB=y
# --- juego: tick de 1 ms (el default 100 Hz da pasos de 10 ms y delays fantasma) ---
CONFIG_FREERTOS_HZ=1000
# --- esp-hosted: SD power (IO26) y PA (IO4) por RPC al C5 ---
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_SLAVE_IDF_TARGET_ESP32C5=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C5=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_P4_C5_CORE_BOARD=y
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_ENABLE_GPIO_EXPANDER=y
# --- DSI: flush seguro con cache apagada (arrastra DW_GDMA_ISR_IRAM_SAFE, que es el que importa) ---
CONFIG_LCD_DSI_ISR_CACHE_SAFE=y
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
